{
  "expo": {
    "name": "RC Trivedi Coaching",
    "slug": "rc-trivedi-coaching",
    "version": "5.0.0",
    "scheme": "rctrivedi",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#002152"
    },
    "android": {
      "package": "com.rctrivedi.coaching",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#002152"
      },
      "permissions": [],
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Banner aur course ki photo chunne ke liye."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b2a9aa60-7a73-4f91-875d-5390a89967d0"
      }
    },
    "owner": "anudiv7446s-team"
  }
}
