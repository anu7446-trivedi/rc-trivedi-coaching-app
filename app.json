{
  "expo": {
    "name": "RC Trivedi Coaching",
    "slug": "rc-trivedi-coaching",
    "version": "4.0.0",
    "scheme": "rctrivedi",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#071B3A"
    },
    "android": {
      "package": "com.rctrivedi.coaching",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#071B3A"
      },
      "permissions": []
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b2a9aa60-7a73-4f91-875d-5390a89967d0"
      }
    },
    "owner": "anudiv7446s-team"
  }
}
