rules_version = '2';
// Banner / course photos: sab dekh sakte hain, sirf admin upload kare.
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() { return request.auth != null && request.auth.token.email in ['rct.anurag.2015@gmail.com']; }
    match /images/{all=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email in ['rct.anurag.2015@gmail.com']
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    // Course ki PDF / notes — sirf admin upload kare.
    // Padh sirf wahi sakta hai jisne course khareeda ho (ya course free ho).
    match /files/materials/{cid}/{file} {
      allow read: if isAdmin() || (request.auth != null && (
        firestore.get(/databases/(default)/documents/courses/$(cid)).data.price <= 0
        || (firestore.exists(/databases/(default)/documents/enrollments/$(request.auth.uid + '_' + cid))
            && firestore.get(/databases/(default)/documents/enrollments/$(request.auth.uid + '_' + cid)).data.expiresAt > request.time)
      ));
      allow write: if isAdmin()
        && request.resource.size < 25 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf' || request.resource.contentType.matches('image/.*'));
    }
    match /files/{all=**} {
      allow read: if isAdmin();
      allow write: if request.auth != null
        && request.auth.token.email in ['rct.anurag.2015@gmail.com']
        && request.resource.size < 25 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf' || request.resource.contentType.matches('image/.*'));
    }
  }
}
