rules_version = '2';

// =====================================================================
//  RC Trivedi Coaching — Firestore Security Rules
//  Firebase Console > Firestore Database > Rules me ye pura paste karke
//  "Publish" dabayein.
//  ⚠️ Neeche YOUR_ADMIN_EMAIL@gmail.com ki jagah apna admin email likhein
//     (wahi jo firebaseConfig.ts me likha hai).
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email in ['YOUR_ADMIN_EMAIL@gmail.com'];
    }
    function studentDoc() {
      return /databases/$(database)/documents/students/$(request.auth.uid);
    }
    function isStudent() {
      return signedIn() && exists(studentDoc()) && get(studentDoc()).data.active == true;
    }
    function member() { return isAdmin() || isStudent(); }

    // App ki settings (naam, phone, UPI) — sab padh sakte hain, sirf admin badle
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /students/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    match /batches/{id} {
      allow read: if member();
      allow write: if isAdmin();
    }

    match /notices/{id} {
      allow read: if member();
      allow write: if isAdmin();
    }

    match /materials/{id} {
      allow read: if member();
      allow write: if isAdmin();
    }

    // Tests: student sirf "Live" test dekh sakta hai
    match /tests/{id} {
      allow read: if isAdmin() || (isStudent() && resource.data.published == true);
      allow write: if isAdmin();
    }

    // Sahi uttar: student ko sirf test submit karne ke BAAD dikhte hain
    match /testKeys/{testId} {
      allow read: if isAdmin() || (isStudent() &&
        exists(/databases/$(database)/documents/results/$(testId + '_' + request.auth.uid)));
      allow write: if isAdmin();
    }

    // Result: ek test ek hi baar (update allowed nahi)
    match /results/{id} {
      allow get: if isAdmin() || (signedIn() && id.matches('.*_' + request.auth.uid + '$'));
      allow list: if isAdmin() || (signedIn() && resource.data.studentId == request.auth.uid);
      allow create: if isAdmin() || (
        isStudent()
        && request.resource.data.studentId == request.auth.uid
        && id == request.resource.data.testId + '_' + request.auth.uid
        && get(/databases/$(database)/documents/tests/$(request.resource.data.testId)).data.published == true
        && request.resource.data.keys().hasOnly(['testId', 'testTitle', 'studentId', 'studentName', 'answers', 'submittedAt'])
      );
      allow update, delete: if isAdmin();
    }

    match /attendance/{id} {
      allow read: if member();
      allow write: if isAdmin();
    }

    // Fees: student sirf apni "pending" entry bhej sakta hai, verify admin karega
    match /payments/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.studentId == request.auth.uid);
      allow create: if isAdmin() || (
        isStudent()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
      );
      allow update, delete: if isAdmin();
    }

    // Admission enquiry form — koi bhi bhej sakta hai, sirf admin padhega
    match /enquiries/{id} {
      allow create: if request.resource.data.name is string
        && request.resource.data.name.size() < 100
        && request.resource.data.mobile is string
        && request.resource.data.mobile.size() < 20
        && request.resource.data.get('message', '').size() < 1000;
      allow read, update, delete: if isAdmin();
    }
  }
}
